# MboWazap / Tchuek-Tech WhatsApp Bot Environment Template

# WhatsApp Bot Identity
OWNER_NUMBER=237653683174
PORT=8080
NODE_ENV=production

# AI Providers & Fallback Chain (DeepSeek -> Groq -> Gemini)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TCHUEKAM_API_KEY=your_gemini_api_key_here
GIPHY_API_KEY=your_giphy_api_key_here

# Product Catalog & Sales Integration
TALLY_FORM_LINK=https://tally.so/r/J9eWDX
CATALOG_STARTER=./catalog/starter.jpg
CATALOG_BUSINESS=./catalog/business.jpg
CATALOG_ELITE=./catalog/elite.jpg

# Optional Online MongoDB (Leave empty to use automatic persistent local disk fallback at ./data/memory)
# MONGODB_URI=mongodb+srv://...

# wacrm bridge (MboWazap protocol v1) — leave empty to run the bot standalone
# wacrm's public origin, no path. Events are POSTed to <WACRM_URL>/api/mbowazap/events.
# WACRM_URL=https://crm.example.com
# Shared HMAC secret, identical in wacrm's .env.local (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The /bridge/* API answers 503 until this is set.
# MBOWAZAP_SECRET=
# Minutes Davila stays quiet for a contact after an agent replies from the wacrm inbox (default 120)
# MBOWAZAP_HANDOFF_MINUTES=120
