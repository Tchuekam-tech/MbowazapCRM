# Root .gitignore for MbowazapCRM Monorepo

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem

# Next.js build outputs
.next/
out/
build/
dist/

# Logs & temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
*.log

# Baileys / WhatsApp bot runtime data
# Anchored to the bot directory on purpose: an unanchored `session/`
# matches ANY directory named "session" in the monorepo and silently
# kept wacrm/src/app/api/mbowazap/session/route.ts out of git. (Rules
# with a slash in the middle, like `data/sessions/`, are anchored to the
# repo root, where they matched nothing.) antisnowflake-bot-main/.gitignore
# holds the authoritative list; these are a backstop only.
/antisnowflake-bot-main/session/
/antisnowflake-bot-main/data/sessions/
/antisnowflake-bot-main/data/session_backup/
/antisnowflake-bot-main/data/bridge/
/antisnowflake-bot-main/baileys_store.json

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
